{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // `src/worker.ts` is the Cloudflare Worker entry (imports `cloudflare:workers`
  // / `agents`). It's built by wrangler/esbuild, NOT by this stdio `tsc` build —
  // excluding it keeps `dist/worker.js` out of the npm/mcpb bundle.
  "exclude": ["node_modules", "dist", "src/worker.ts"]
}
